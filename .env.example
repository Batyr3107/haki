# Database
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
# ВАЖНО: Измените на случайную строку в продакшене!
# Сгенерируйте с помощью: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Для продакшена используйте URL вашего сайта:
# NEXTAUTH_URL="https://yourdomain.com"

# ============================================
# ОПЦИОНАЛЬНЫЕ УЛУЧШЕНИЯ
# ============================================

# Rate Limiting (Upstash Redis)
# Получите credentials на: https://upstash.com/
# Если не настроено, rate limiting будет отключен
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Analytics
# Google Analytics - получите ID на: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Plausible Analytics - укажите ваш домен
# Альтернатива Google Analytics, privacy-focused
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Error Tracking (Sentry)
# Получите DSN на: https://sentry.io/
# Используется для отслеживания ошибок в production
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Monitoring (Datadog)
# Получите credentials на: https://www.datadoghq.com/
# Используется для мониторинга производительности
NEXT_PUBLIC_DATADOG_APPLICATION_ID=""
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=""
NEXT_PUBLIC_DATADOG_SITE="datadoghq.com"
